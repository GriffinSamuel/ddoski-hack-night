# Env var names for the whole repo. Values live in apps/api/.env (backend) and apps/web/.env.local (frontend); both are gitignored.
# This Supabase project uses the new key format: the sb_publishable_... key goes in NEXT_PUBLIC_SUPABASE_ANON_KEY
# and the sb_secret_... key goes in SUPABASE_SERVICE_ROLE_KEY. They are drop-in replacements for the legacy keys.

# apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
# http://localhost:3000 locally; the Vercel URL in production
NEXT_PUBLIC_SITE_URL=

# apps/api/.env
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ALLOWED_ORIGINS=http://localhost:3000

# test only
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
BASE_URL=http://localhost:3000
